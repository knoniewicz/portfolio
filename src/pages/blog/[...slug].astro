---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MonoLink from '../../components/MonoLink.astro';
import TagList from '../../components/TagList.astro';
import { getPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} / Kacper Noniewicz`} description={post.data.description}>
  <article class="py-16 pb-20">
    <p class="mb-10"><MonoLink href="/blog/">&larr; Blog</MonoLink></p>

    <header class="mb-12 pb-8 border-b border-(--color-border)">
      <p class="font-mono text-[0.6875rem] uppercase tracking-widest text-text-muted mb-4">
        {formatDate(post.data.date)}{post.data.draft && ' · draft'}
      </p>
      <h1 class="text-[clamp(2rem,5vw,3rem)] font-bold tracking-tight leading-tight mb-4 max-w-180">{post.data.title}</h1>
      <p class="text-[1.0625rem] text-text-secondary max-w-150 leading-relaxed mb-5">{post.data.description}</p>
      <TagList tags={post.data.tags} />
    </header>

    <div class="post max-w-180">
      <Content />
    </div>
  </article>
</Base>
