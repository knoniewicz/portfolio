---
import Base from '../../layouts/Base.astro';
import ProjectPageHeader from '../../components/ProjectPageHeader.astro';
import ProjectSection from '../../components/ProjectSection.astro';
import ProjectList from '../../components/ProjectList.astro';
import ProjectProse from '../../components/ProjectProse.astro';
import TagList from '../../components/TagList.astro';
---

<Base title="Anima / Kacper Noniewicz" description="Private self-hosted system of services for personal infrastructure.">
  <div class="py-16 pb-20">
      <ProjectPageHeader
        label="Private / Self-hosted"
        title="Anima"
        intro="A private, event-driven platform for my personal infrastructure. Fully self-hosted, with no cloud dependency. Kor, Korpus and Kron started here and were extracted into standalone open-source projects."
      />

      <div class="max-w-180">
        <ProjectSection title="What it does">
          <ProjectList
            items={[
              "Collects data from external APIs, devices and local integrations with Lua connectors (Kron)",
              "Validates and stores every record through a single writer (Korpus)",
              "Connects every service over one small message router (Kor)",
              "Runs automations on a schedule or an event, with an optional agent step and a confirmation before anything acts on the world",
              "Exposes its handlers to agents as MCP tools and sends alerts through ntfy",
            ]}
          />
        </ProjectSection>

        <ProjectSection title="Why I built it">
          <ProjectProse>
            <p>
              I wanted a system that remembers, automates, and stays under my control.
              No cloud dependency, no telemetry, and no vendor lock-in. Anima is the
              umbrella that ties together the infrastructure, memory, automation, and
              agent tooling I build for my own use.
            </p>
          </ProjectProse>
        </ProjectSection>

        <ProjectSection title="How it works">
          <ProjectProse>
            <p>
              Every service talks over Kor. Collectors in Kron fetch data and write it
              to Korpus as acknowledged requests with deterministic ids, so a retry is
              an upsert. Korpus validates against the schema the owning service
              registered, commits to SQLite and announces the write. Automations react
              to those events or to the clock, and the UI reads through the same
              handlers. The first version used Redis, Postgres and a custom supervisor;
              the current one replaced all three with Kor, SQLite and systemd.
            </p>
          </ProjectProse>
        </ProjectSection>

        <ProjectSection title="Stack">
          <TagList
            tags={[
              "Go",
              "Lua",
              "SQLite",
              "JSON Schema",
              "systemd",
              "MCP",
            ]}
          />
        </ProjectSection>

        <ProjectSection title="Status">
          <ProjectProse>
            <p>Private. Actively developed.</p>
          </ProjectProse>
        </ProjectSection>
      </div>
    </div>
  </div>
</Base>
