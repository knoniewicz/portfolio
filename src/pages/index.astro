---
import Base from '../layouts/Base.astro';
import { age } from '../lib/profile';
import { getPosts } from '../lib/posts';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kacper Noniewicz',
  url: 'https://noniewicz.eu',
  jobTitle: 'Software Developer',
  worksFor: { '@type': 'Organization', name: 'Schauer Agrotronic' },
  address: { '@type': 'PostalAddress', addressCountry: 'AT' },
  alumniOf: { '@type': 'EducationalOrganization', name: 'HTBLA Grieskirchen' },
  award: ['Agrarfuchs 2026, Gold (work efficiency category), for SIGI', 'Accenture Hackathon Vienna 2022, 2nd place'],
  knowsAbout: ['LLMs', 'RAG', 'MCP', 'Go', 'TypeScript', 'Angular', 'Python', 'SQLite', 'Embedded systems', 'Event-driven systems'],
  knowsLanguage: ['Polish', 'German', 'English'],
  sameAs: ['https://github.com/knoniewicz', 'https://www.linkedin.com/in/noniewicz'],
};

const awardUrl = 'https://agraria.at/neuheiten/agrarfuchs-2026-das-sind-die-preistr-ger';

const projects = [
  { name: 'SIGI', href: awardUrl, status: 'gold · 2026', line: "Self-hosted AI service assistant that reads the machine's live state over MCP before answering." },
  { name: 'Bober', href: '/projects/bober/', status: 'daily', line: 'My own agent. One Go process, two tools, everything else in Lua. Also runs my home infrastructure.' },
  { name: 'kor · korpus · kron', href: '/projects/kor/', status: 'retired', line: 'Router, acked-write store and Lua automations. Ran my home infrastructure until Bober took over.' },
  { name: 'Pularis', href: '/projects/pularis/', status: 'open source', line: 'Polls HTTP APIs and publishes events. Describe a source in one TOML file.' },
  { name: 'Anima', href: '/projects/anima/', status: 'retired', line: 'My old self-hosted platform. Too many services for one person, replaced by Bober.' },
  { name: 'Futura', href: '/projects/futura/', status: '2024', line: 'Diploma project: an end-to-end ML pipeline for next-day stock direction.' },
];

const posts = await getPosts();
---

<Base home title="Kacper Noniewicz | Software Developer, AI systems for real machines" description="Software developer building AI systems that work with real machines. Built most of SIGI, Gold at Agrarfuchs 2026.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />

  <div class="w">
    <div class="me">
      <img src="/kacper.jpg" alt="Kacper Noniewicz" width="460" height="460" />
      <p>Kacper Noniewicz, {age}<br />Upper Austria · Polish, German, English<br /><a href="mailto:kacper@noniewicz.eu">kacper@noniewicz.eu</a></p>
    </div>

    <main class="t">
      <h1>Hi, I'm Kacper. I build AI that works with real machines.</h1>
      <p>By day I'm a software developer at Schauer Agrotronic, where the software runs on barn equipment: low-power hardware, serial devices, touch screens in a stable. I built most of <strong>SIGI</strong>, our self-hosted service assistant that reads the machine's live state before answering. It won <a href={awardUrl}>Gold at Agrarfuchs 2026</a>.</p>
      <p>After work I build the same kind of thing for myself, in Go: a small agent I use every day for code and for running my home infrastructure. Some of what I build is <a href="https://github.com/knoniewicz">open source</a>.</p>

      <section class="proj" id="projects">
        <small class="l">projects</small>
        {projects.map((p) => (
          <a class="p" href={p.href}>
            <h2>{p.name}</h2>
            <i>{p.status}</i>
            <span>{p.line}</span>
          </a>
        ))}
      </section>
    </main>

    <aside class="side">
      <div id="experience">
        <small class="l">work</small>
        <ul>
          <li>Schauer Agrotronic<i>2022 – now</i></li>
          <li>HTBLA Grieskirchen<i>2019 – 2024</i></li>
          <li>Accenture Hackathon, 2nd<i>2022</i></li>
        </ul>
      </div>
      {posts.length > 0 && (
        <div>
          <small class="l">writing</small>
          <ul>
            {posts.map((post) => <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>)}
          </ul>
        </div>
      )}
      <div id="contact">
        <small class="l">elsewhere</small>
        <ul>
          <li><a href="https://github.com/knoniewicz">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/noniewicz">LinkedIn</a></li>
        </ul>
      </div>
    </aside>
  </div>
</Base>

<style>
  .w {
    max-width: 1080px; margin: 0 auto; padding: 80px 24px;
    display: grid; grid-template-columns: 300px minmax(0, 1fr); column-gap: 72px;
    grid-template-areas: "me main" "side main"; grid-template-rows: auto 1fr; align-items: start;
  }
  .me { grid-area: me; }
  .t { grid-area: main; min-width: 0; }
  .side { grid-area: side; margin-top: 36px; display: grid; gap: 26px; }

  .me img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 4px; display: block; }
  .me p { font-size: 13.5px; color: var(--color-text-muted); margin: 12px 0 0; line-height: 1.6; }
  .me a, .side a { color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-border-subtle); }
  .me a:hover, .side a:hover { color: var(--color-text); text-decoration-color: currentColor; }

  h1 { font: 400 52px/1.08 var(--font-serif); letter-spacing: -0.015em; margin: 0 0 28px; text-wrap: balance; }
  .t > p { font-size: 18px; line-height: 1.7; color: var(--color-text-secondary); margin: 0 0 18px; max-width: 58ch; }
  .t p strong { color: var(--color-text); font-weight: 500; }
  .t p a { color: var(--color-text); text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: 4px; }

  small.l { display: block; font-size: 12px; color: var(--color-text-muted); margin-bottom: 8px; }

  .side ul { list-style: none; margin: 0; padding: 0; font-size: 14px; }
  .side li { display: flex; justify-content: space-between; gap: 10px; padding: 5px 0; color: var(--color-text-secondary); }
  .side li i { font-style: normal; color: var(--color-text-muted); font-size: 12.5px; white-space: nowrap; }

  .proj { margin-top: 48px; }
  .proj > small.l { margin-bottom: 14px; }
  .p { padding: 18px 0; border-top: 1px solid var(--color-border-subtle); display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 16px; }
  .p:last-child { border-bottom: 1px solid var(--color-border-subtle); }
  .p h2 { font: 500 22px/1.3 var(--font-serif); margin: 0; transition: color .2s; }
  .p i { font-style: normal; color: var(--color-text-muted); font-size: 13px; padding-top: 6px; }
  .p span { grid-column: 1 / -1; color: var(--color-text-secondary); font-size: 15px; }
  .p:hover h2 { color: var(--color-accent); }

  @media (max-width: 820px) {
    .w { grid-template-columns: 1fr; grid-template-areas: "me" "main" "side"; padding: 40px 20px 56px; }
    .me { display: grid; grid-template-columns: 110px 1fr; gap: 16px; align-items: end; margin-bottom: 32px; }
    .me p { margin: 0; }
    h1 { font-size: 38px; }
    .t > p { font-size: 17px; }
    .side { margin-top: 48px; }
  }
</style>
