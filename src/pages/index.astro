---
import Base from '../layouts/Base.astro';
import { age } from '../lib/profile';
import { getPosts } from '../lib/posts';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kacper Noniewicz',
  url: 'https://noniewicz.eu',
  jobTitle: 'Software Developer',
  worksFor: { '@type': 'Organization', name: 'Schauer Agrotronic' },
  address: { '@type': 'PostalAddress', addressCountry: 'AT' },
  alumniOf: { '@type': 'EducationalOrganization', name: 'HTBLA Grieskirchen' },
  award: ['Agrarfuchs 2026, Gold (work efficiency category), for SIGI', 'Accenture Hackathon Vienna 2022, 2nd place'],
  knowsAbout: ['LLMs', 'RAG', 'MCP', 'Go', 'TypeScript', 'Angular', 'Python', 'SQLite', 'Embedded systems', 'Event-driven systems'],
  knowsLanguage: ['Polish', 'German', 'English'],
  sameAs: ['https://github.com/knoniewicz', 'https://www.linkedin.com/in/noniewicz'],
};

const awardUrl = 'https://agraria.at/neuheiten/agrarfuchs-2026-das-sind-die-preistr-ger';

const projects = [
  { id: 'sigi', name: 'SIGI', href: awardUrl, status: 'gold · 2026', line: "Self-hosted AI service assistant that reads the machine's live state over MCP before answering." },
  { id: 'bober', name: 'Bober', href: '/projects/bober/', status: 'daily', line: 'My own agent. One Go process, two tools, everything else in Lua. Also runs my home infrastructure.' },
  { id: 'spine', name: 'kor · korpus · kron', parts: [['kor', '/projects/kor/'], ['korpus', '/projects/korpus/'], ['kron', '/projects/kron/']], status: 'retired', line: 'Router, acked-write store and Lua automations. Ran my home infrastructure until Bober took over.' },
  { id: 'pularis', name: 'Pularis', href: '/projects/pularis/', status: 'open source', line: 'Polls HTTP APIs and publishes events. Describe a source in one TOML file.' },
  { id: 'anima', name: 'Anima', href: '/projects/anima/', status: 'retired', line: 'My old self-hosted platform. Too many services for one person, replaced by Bober.' },
  { id: 'futura', name: 'Futura', href: '/projects/futura/', status: '2024', line: 'Diploma project: an end-to-end ML pipeline for next-day stock direction.' },
];

const posts = await getPosts();
---

<Base home title="Kacper Noniewicz | Software Developer, AI systems for real machines" description="Software developer building AI systems that work with real machines. Built most of SIGI, Gold at Agrarfuchs 2026.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />

  <div class="w">
    <div class="me">
      <div class="ph rise" id="ph"><img src="/kacper.jpg" alt="Kacper Noniewicz" width="460" height="460" /><span class="sheen" aria-hidden="true"></span></div>
      <p class="rise" style="--i:1">Kacper Noniewicz, {age}<br />Upper Austria · Polish, German, English<br /><span class="clock" id="clock" hidden></span><br id="clockbr" hidden /><a class="ul" href="mailto:kacper@noniewicz.eu">kacper@noniewicz.eu</a></p>
    </div>

    <main class="t">
      <h1 class="rise" style="--i:1">Hi, I'm Kacper. I build AI that works with real machines.</h1>
      <p class="rise" style="--i:2">By day I'm a software developer at Schauer Agrotronic, where the software runs on barn equipment: low-power hardware, serial devices, touch screens in a stable. I built most of <strong>SIGI</strong>, our self-hosted service assistant that reads the machine's live state before answering. It won <a class="ul" href={awardUrl}>Gold at Agrarfuchs 2026</a>.</p>
      <p class="rise" style="--i:3">After work I build the same kind of thing for myself, in Go: a small agent I use every day for code and for running my home infrastructure. Some of what I build is <a class="ul" href="https://github.com/knoniewicz">open source</a>.</p>

      <section class="proj" id="projects">
        <span class="glide" aria-hidden="true"></span>
        <small class="l rise" style="--i:4">projects</small>
        {projects.map((p, n) => p.parts ? (
          <div class="p rise" data-peek={p.id} style={`--i:${n + 4}`}>
            <h2>{p.parts.map(([n, h], i) => <>{i > 0 && " · "}<a href={h}>{n}</a></>)}</h2>
            <i>{p.status}</i>
            <span>{p.line}</span>
          </div>
        ) : (
          <a class="p rise" data-peek={p.id} style={`--i:${n + 4}`} href={p.href}>
            <h2>{p.name}</h2>
            <i>{p.status}<b aria-hidden="true">→</b></i>
            <span>{p.line}</span>
          </a>
        ))}
      </section>
    </main>

    <aside class="side rise" style="--i:5">
      <div id="experience">
        <small class="l">work</small>
        <ul>
          <li>Schauer Agrotronic<i>2022 – now</i></li>
          <li>HTBLA Grieskirchen<i>2019 – 2024</i></li>
          <li>Accenture Hackathon, 2nd<i>2022</i></li>
        </ul>
      </div>
      {posts.length > 0 && (
        <div>
          <small class="l">writing</small>
          <ul>
            {posts.map((post) => <li><a class="ul" href={`/blog/${post.id}/`}>{post.data.title}</a></li>)}
          </ul>
        </div>
      )}
      <div id="contact">
        <small class="l">elsewhere</small>
        <ul>
          <li><a class="ul" href="https://github.com/knoniewicz">GitHub</a></li>
          <li><a class="ul" href="https://www.linkedin.com/in/noniewicz">LinkedIn</a></li>
        </ul>
      </div>
    </aside>
  </div>

  <div class="peek" id="peek" aria-hidden="true">
    <div data-for="sigi"><b class="medal">Gold</b><small>Agrarfuchs 2026 · Agraria Wels</small><ol><li>SDU-X controller</li><li>MCP server</li><li>aggregator</li><li>self-hosted model + manuals</li><li class="hi">answer from the real state</li></ol></div>
    <div data-for="bober"><pre><span class="dim">›</span> fix the flaky test in core
<span class="dim">shell_command</span>  go test ./core/...
<span class="dim">apply_patch</span>    core/loop.go  <span class="hi">+4 −2</span>
<span class="dim">shell_command</span>  go test ./core/...  <span class="hi">ok</span></pre></div>
    <div data-for="spine"><pre><span class="dim">service →</span> kor <span class="dim">korpus.write</span>
<span class="dim">       →</span> json schema
<span class="dim">       →</span> sqlite commit
<span class="dim">       →</span> <span class="hi">ack</span> + korpus.&lt;type&gt;.written</pre></div>
    <div data-for="pularis"><pre>name = <span class="hi">"example_source"</span>
endpoint = <span class="hi">"https://api.example.com/status"</span>
poll_interval_seconds = 15

[[events]]
publish_when = <span class="hi">"state != ''"</span></pre></div>
    <div data-for="anima"><ol class="evo"><li><s>redis · postgres · supervisor</s></li><li><s>kor · sqlite · systemd</s></li><li class="hi">bober + a few lua scripts</li></ol></div>
    <div data-for="futura"><svg viewBox="0 0 220 64" class="spark"><polyline points="0,44 18,40 36,46 54,30 72,34 90,22 108,28 126,18 144,26 162,14 180,20 198,10 220,16" /></svg><small>~100 indicators → 60 features → LightGBM → next day ↑↓</small></div>
  </div>
</Base>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (!still && fine) {
    // Photo leans toward the cursor; a soft light follows it.
    const ph = document.getElementById("ph");
    if (ph) {
      let raf = 0;
      ph.addEventListener("pointermove", (e) => {
        const r = ph.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          ph.style.setProperty("--rx", ((0.5 - y) * 9).toFixed(2) + "deg");
          ph.style.setProperty("--ry", ((x - 0.5) * 11).toFixed(2) + "deg");
          ph.style.setProperty("--mx", (x * 100).toFixed(1) + "%");
          ph.style.setProperty("--my", (y * 100).toFixed(1) + "%");
        });
      });
      ph.addEventListener("pointerleave", () => { ph.style.setProperty("--rx", "0deg"); ph.style.setProperty("--ry", "0deg"); });
    }

    // One highlight glides between project rows instead of each row lighting up on its own.
    const list = document.getElementById("projects");
    const glide = list?.querySelector(".glide") as HTMLElement | null;
    if (list && glide) {
      list.querySelectorAll<HTMLElement>(".p").forEach((row) => {
        row.addEventListener("pointerenter", () => {
          glide.style.transform = `translateY(${row.offsetTop}px)`;
          glide.style.height = row.offsetHeight + "px";
          glide.classList.add("on");
        });
      });
      list.addEventListener("pointerleave", () => glide.classList.remove("on"));
    }


    // A preview card trails the cursor over the project list, on a spring, leaning with speed.
    const peek = document.getElementById("peek");
    if (list && peek) {
      let tx = 0, ty = 0, x = 0, y = 0, vx = 0, active = false, run = 0;
      const step = () => {
        const nx = x + (tx - x) * 0.16, ny = y + (ty - y) * 0.16;
        vx = vx * 0.8 + (nx - x) * 0.2; x = nx; y = ny;
        peek.style.transform = `translate(${x + 24}px, ${y - 30}px) rotate(${Math.max(-8, Math.min(8, vx * 0.6))}deg)`;
        run = active || Math.abs(tx - x) > 0.5 ? requestAnimationFrame(step) : 0;
      };
      list.addEventListener("pointermove", (e) => { tx = e.clientX; ty = e.clientY; if (!run) run = requestAnimationFrame(step); });
      list.querySelectorAll<HTMLElement>("[data-peek]").forEach((row) => {
        row.addEventListener("pointerenter", (e) => {
          if (!active) { x = tx = e.clientX; y = ty = e.clientY; }
          active = true;
          peek.querySelectorAll<HTMLElement>("[data-for]").forEach((c) => c.classList.toggle("on", c.dataset.for === row.dataset.peek));
          peek.classList.add("on");
          if (!run) run = requestAnimationFrame(step);
        });
      });
      list.addEventListener("pointerleave", () => { active = false; peek.classList.remove("on"); });
    }
  }

  // Local time where I am, so the page feels like someone is home.
  const clock = document.getElementById("clock");
  if (clock) {
    const fmt = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Vienna" });
    const tick = () => { clock.textContent = fmt.format(new Date()) + " here right now"; };
    tick(); clock.hidden = false; document.getElementById("clockbr")?.removeAttribute("hidden"); setInterval(tick, 15000);
  }
</script>

<style>
  .w {
    max-width: 1080px; margin: 0 auto; padding: 80px 24px;
    display: grid; grid-template-columns: 300px minmax(0, 1fr); column-gap: 72px;
    grid-template-areas: "me main" "side main"; grid-template-rows: auto 1fr; align-items: start;
  }
  .me { grid-area: me; }
  .t { grid-area: main; min-width: 0; }
  .side { grid-area: side; margin-top: 36px; display: grid; gap: 26px; }

  .ph { position: relative; border-radius: 4px; overflow: hidden; transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .5s cubic-bezier(.2,.7,.2,1); will-change: transform; }
  .sheen { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .5s; background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255,240,225,.16), transparent 55%); mix-blend-mode: screen; }
  .ph:hover .sheen { opacity: 1; }
  .proj { position: relative; }
  .glide { position: absolute; left: -16px; right: -16px; top: 0; height: 0; border-radius: 6px; background: var(--color-bg-subtle); opacity: 0; pointer-events: none; z-index: -1; transition: transform .45s cubic-bezier(.2,.8,.2,1), height .45s cubic-bezier(.2,.8,.2,1), opacity .3s; }
  .glide.on { opacity: 1; }
  .glide::before { content: ""; position: absolute; left: 0; top: 14px; bottom: 14px; width: 2px; border-radius: 2px; background: var(--color-accent); }
  .t { position: relative; z-index: 0; }

  .clock { font-variant-numeric: tabular-nums; }
  .clock::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #7fbf8a; margin-right: 8px; vertical-align: 1px; animation: breathe 2.4s ease-in-out infinite; }
  @keyframes breathe { 50% { opacity: .35; } }

  .peek { position: fixed; left: 0; top: 0; z-index: 40; width: 300px; padding: 14px 16px; border-radius: 8px; background: #1d1c1b; border: 1px solid var(--color-border-subtle); box-shadow: 0 18px 50px rgba(0,0,0,.45); pointer-events: none; opacity: 0; scale: .92; transition: opacity .25s, scale .35s cubic-bezier(.2,.8,.2,1); font-size: 13px; color: var(--color-text-secondary); }
  .peek.on { opacity: 1; scale: 1; }
  .peek > div { display: none; }
  .peek > div.on { display: block; }
  .peek pre { margin: 0; font: 12px/1.65 var(--font-mono); white-space: pre; overflow: hidden; }
  .peek .dim { color: var(--color-text-muted); }
  .peek .hi { color: var(--color-accent); }
  .peek small { display: block; color: var(--color-text-muted); font-size: 12px; margin-top: 4px; }
  .peek .medal { font: 400 34px/1 var(--font-serif); color: var(--color-accent); }
  .peek ol { list-style: none; margin: 12px 0 0; padding: 0; counter-reset: s; }
  .peek ol li { padding-left: 18px; position: relative; line-height: 1.8; }
  .peek ol li::before { content: "↓"; position: absolute; left: 0; color: var(--color-text-muted); }
  .peek ol li:first-child::before { content: "·"; }
  .peek ol.evo { margin: 0; }
  .peek s { color: var(--color-text-muted); text-decoration-color: var(--color-accent); }
  .spark { width: 100%; height: 64px; display: block; }
  .spark polyline { fill: none; stroke: var(--color-accent); stroke-width: 1.6; stroke-linejoin: round; stroke-dasharray: 400; stroke-dashoffset: 400; }
  .peek.on [data-for="futura"].on .spark polyline { animation: draw 1.1s cubic-bezier(.2,.7,.2,1) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .clock::before, .spark polyline { animation: none; stroke-dashoffset: 0; } }
  .me img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; filter: saturate(.85) brightness(.95); transition: transform 1.2s cubic-bezier(.2,.7,.2,1), filter .8s; }
  .ph:hover img { transform: scale(1.035); filter: saturate(1.05) brightness(1); }
  .me p { font-size: 13.5px; color: var(--color-text-muted); margin: 12px 0 0; line-height: 1.6; }
  .me a, .side a { color: var(--color-text-secondary); }

  h1 { font: 400 52px/1.08 var(--font-serif); letter-spacing: -0.015em; margin: 0 0 28px; text-wrap: balance; }
  .t > p { font-size: 18px; line-height: 1.7; color: var(--color-text-secondary); margin: 0 0 18px; max-width: 58ch; }
  .t p strong { color: var(--color-text); font-weight: 500; }
  .t p a { color: var(--color-text); }

  small.l { display: block; font-size: 12px; color: var(--color-text-muted); margin-bottom: 8px; }

  .side ul { list-style: none; margin: 0; padding: 0; font-size: 14px; }
  .side li { display: flex; justify-content: space-between; gap: 10px; padding: 5px 0; color: var(--color-text-secondary); }
  .side li i { font-style: normal; color: var(--color-text-muted); font-size: 12.5px; white-space: nowrap; }

  .proj { margin-top: 48px; }
  .proj > small.l { margin-bottom: 14px; }
  .p { padding: 18px 0; border-top: 1px solid var(--color-border-subtle); display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 16px; }
  .p:last-child { border-bottom: 1px solid var(--color-border-subtle); }
  .p h2 { font: 500 22px/1.3 var(--font-serif); margin: 0; transition: color .2s; }
  .p i { font-style: normal; color: var(--color-text-muted); font-size: 13px; padding-top: 6px; }
  .p span { grid-column: 1 / -1; color: var(--color-text-secondary); font-size: 15px; }
  .p { position: relative; }
  .p h2 { transition: color .25s, transform .45s cubic-bezier(.2,.7,.2,1); }
  a.p:hover h2 { color: var(--color-accent); transform: translateX(6px); }
  .p h2 a { transition: color .2s; }
  .p h2 a:hover { color: var(--color-accent); }
  .p i { position: relative; }
  .p i b { position: absolute; left: 100%; display: inline-block; font-weight: 400; margin-left: 8px; opacity: 0; transform: translateX(-6px); transition: opacity .3s, transform .45s cubic-bezier(.2,.7,.2,1); color: var(--color-accent); }
  a.p:hover i b { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .me img, .p h2, .p i b, .ph, .glide { transition: none; } }

  @media (max-width: 820px) {
    .w { grid-template-columns: 1fr; grid-template-areas: "me" "main" "side"; padding: 40px 20px 56px; }
    .me { display: grid; grid-template-columns: 110px 1fr; gap: 16px; align-items: end; margin-bottom: 32px; }
    .me p { margin: 0; }
    h1 { font-size: 38px; }
    .t > p { font-size: 17px; }
    .side { margin-top: 48px; }
  }
</style>
