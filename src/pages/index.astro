---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TimelineItem from '../components/TimelineItem.astro';
import MonoLink from '../components/MonoLink.astro';
import { featured, projectHref } from '../lib/projects';
import TagList from '../components/TagList.astro';
import { age, yearsWorking, yearsFullTime } from '../lib/profile';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kacper Noniewicz',
  url: 'https://noniewicz.eu',
  jobTitle: 'Software Developer',
  worksFor: { '@type': 'Organization', name: 'Schauer Agrotronic' },
  address: { '@type': 'PostalAddress', addressCountry: 'AT' },
  alumniOf: { '@type': 'EducationalOrganization', name: 'HTBLA Grieskirchen' },
  award: ['Agrarfuchs 2026, Gold (work efficiency category), for SIGI', 'Accenture Hackathon Vienna 2022, 2nd place'],
  knowsAbout: ['LLMs', 'RAG', 'MCP', 'Go', 'TypeScript', 'Angular', 'Kotlin', 'Python', 'SQLite', 'Embedded systems', 'Event-driven systems'],
  knowsLanguage: ['Polish', 'German', 'English'],
  sameAs: ['https://github.com/knoniewicz', 'https://www.linkedin.com/in/noniewicz'],
};
---

<Base title="Kacper Noniewicz | Software Developer, AI systems for real machines" description="Software developer building AI systems that work with real machines. Built most of SIGI, Gold at Agrarfuchs 2026.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />


  <!-- Hero -->
  <section class="py-20 max-md:py-12 grid grid-cols-[1fr_260px] max-md:grid-cols-1 gap-16 max-md:gap-10 items-center border-b border-(--color-border)">
    <div>
      <span class="block font-mono text-[0.6875rem] uppercase tracking-widest text-text-muted mb-5">Software Developer</span>
      <h1 class="font-mono text-[clamp(2.5rem,6vw,3.5rem)] max-md:text-[2rem] font-medium tracking-tight leading-none mb-7 uppercase">Kacper<br />Noniewicz</h1>
      <p class="text-[1.0625rem] text-text-secondary max-w-120 leading-relaxed">I build AI systems that work with real machines: self-hosted models, live device data over MCP, and the infrastructure underneath.</p>
      <dl class="grid grid-cols-2 gap-x-6 gap-y-4 mt-8 max-w-90">
        <div><dt class="font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-text-muted">Experience</dt><dd class="mt-1 text-sm font-semibold">{yearsWorking}+ years, {yearsFullTime}+ full-time</dd></div>
        <div><dt class="font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-text-muted">Age</dt><dd class="mt-1 text-sm font-semibold">{age}</dd></div>
      </dl>
      <div class="flex gap-6 mt-6 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-text-muted">
        <span>Schauer Agrotronic</span>
        <span class="relative before:content-['/'] before:absolute before:-left-4 before:text-border-subtle">Austria</span>
      </div>
      <div class="flex gap-5 mt-8 pt-6 border-t border-border-subtle flex-wrap">
        <MonoLink href="https://github.com/knoniewicz" target="_blank" rel="noopener noreferrer">GitHub</MonoLink>
        <MonoLink href="https://www.linkedin.com/in/noniewicz" target="_blank" rel="noopener noreferrer">LinkedIn</MonoLink>
        <MonoLink href="mailto:kacper@noniewicz.eu">Email</MonoLink>
      </div>
    </div>
    <div class="max-md:order-first max-md:max-w-45">
      <img src="/kacper.jpg" alt="Kacper Noniewicz" width="260" height="260" class="w-full aspect-square object-cover grayscale-30 contrast-[1.05] border-2 border-(--color-border)" />
    </div>
  </section>

  <!-- About -->
  <section class="py-16 border-t border-(--color-border)" id="about">
    <SectionLabel text="About" />
    <div class="max-w-180 space-y-4">

      <p class="text-text-secondary">
        At Schauer Agrotronic I build software for barn equipment that has to work under real constraints: low-power embedded hardware, device integration over serial interfaces, and touch-first operation in a barn.
      </p>
      <p class="text-text-secondary">
        I built most of <strong class="text-(--color-text)">SIGI</strong>, our AI service assistant, which won Gold at Agrarfuchs 2026: a self-hosted model, retrieval over our manuals, an MCP server for our controllers and an aggregator that gives the agent one endpoint for every device. I also led the migration of our touch interfaces from legacy Angular to the current stack, and mentored an intern along the way.
      </p>
      <p class="text-text-secondary">
        On my own time I build the same kind of systems for myself, in Go: a message router, a durable store and a sandboxed Lua automation host, all open source, plus an agent that runs my home infrastructure.
      </p>

      <TagList tags={["Polish", "German", "English"]} />
    </div>
  </section>

  <!-- Projects -->
  <section class="py-16 border-t border-(--color-border)" id="projects">
    <SectionLabel text="Projects" />
    <div>
      {featured.map((project, i) => (
        <ProjectCard
          name={project.name}
          state={project.state}
          summary={project.summary}
          labels={project.labels}
          href={projectHref(project)}
          external={!!project.url}
          first={i === 0}
        />
      ))}
    </div>
    <div class="mt-6">
      <MonoLink href="/projects/">View all projects</MonoLink>
    </div>
  </section>

  <!-- Experience -->
  <section class="py-16 border-t border-(--color-border)" id="experience">
    <SectionLabel text="Experience" />
    <div>
      <TimelineItem date="11/2026" title="Agrarfuchs 2026, Gold" org="Agraria Wels, work efficiency category">
          Built most of SIGI, Schauer Agrotronic's AI service assistant: a self-hosted model with retrieval over our documentation, an MCP server for SDU-X and an MCP aggregator that gives the agent one endpoint for all our devices. Mentored an intern on the project. <a href="https://agraria.at/neuheiten/agrarfuchs-2026-das-sind-die-preistr-ger" target="_blank" rel="noopener noreferrer" class="border-b border-border-subtle hover:border-(--color-text)">Winners</a>
      </TimelineItem>
      <TimelineItem date="07/2024 – present" title="Software Developer" org="Schauer Agrotronic, Full-time">
          Own our AI work end to end, from architecture to production: built most of SIGI (above). Led the migration of the product line's touch interfaces from legacy Angular to the current stack. Control software for constrained hardware.
      </TimelineItem>
      <TimelineItem date="06/2022 – 06/2024" title="Software Developer" org="Schauer Agrotronic, Part-time">
          Started part-time alongside school. Built and maintained the Angular touch interfaces on our controllers, with a focus on responsiveness on low-power hardware.
      </TimelineItem>
      <TimelineItem date="04/2022" title="Accenture Hackathon Vienna" org="2nd Place" last>
        2nd place. Built and pitched under time pressure in a team competition.
      </TimelineItem>
    </div>
  </section>

  <!-- Education -->
  <section class="py-16 border-t border-(--color-border)" id="education">
    <SectionLabel text="Education" />
    <div>
      <TimelineItem date="2019 – 2024" title="HTBLA Grieskirchen" org="Informatik / Computer Sciences (EQF Level 5)" last>
        Technical diploma with computer sciences specialization. Diploma project: Futura, an ML pipeline for stock trend prediction (my scope: Python/Jupyter, TA-Lib, RFE, LightGBM, MongoDB writeback).
      </TimelineItem>
    </div>
  </section>

  <!-- Contact -->
  <section class="py-16 border-t border-(--color-border)" id="contact">
    <SectionLabel text="Contact" />
    <div class="max-w-180">
      <p class="text-text-secondary">Reach out for work, questions about my projects, or just to talk shop.</p>
    </div>
    <div class="flex flex-col gap-2 mt-6">
      <a href="mailto:kacper@noniewicz.eu" class="font-mono text-sm text-text-secondary w-fit border-b border-transparent hover:text-(--color-text) hover:border-(--color-text) transition-colors">kacper@noniewicz.eu</a>
      <a href="https://github.com/knoniewicz" target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-text-secondary w-fit border-b border-transparent hover:text-(--color-text) hover:border-(--color-text) transition-colors">github.com/knoniewicz</a>
      <a href="https://www.linkedin.com/in/noniewicz" target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-text-secondary w-fit border-b border-transparent hover:text-(--color-text) hover:border-(--color-text) transition-colors">linkedin.com/in/noniewicz</a>
    </div>
  </section>

</Base>
