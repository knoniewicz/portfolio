---
// One-page CV, built from the same data as the rest of the site.
// scripts/cv-pdf.mjs prints this page to /cv.pdf after every build.
import { projects } from '../lib/projects';
import { age, skills } from '../lib/profile';

const pick = (slug: string) => projects.find((p) => p.slug === slug)!;
const work = ['bober', 'pularis', 'kor-stack', 'futura'].map(pick);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Kacper Noniewicz, CV</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <article>
      <header>
        <div>
          <h1>Kacper Noniewicz</h1>
          <p class="role">Software Developer · AI systems for real machines</p>
        </div>
        <p class="contact">
          <a href="mailto:kacper@noniewicz.eu">kacper@noniewicz.eu</a><br />
          <a href="https://noniewicz.eu">noniewicz.eu</a> · <a href="https://github.com/knoniewicz">github.com/knoniewicz</a><br />
          <a href="https://www.linkedin.com/in/noniewicz">linkedin.com/in/noniewicz</a><br />
          Upper Austria · {age} · Polish, German, English
        </p>
      </header>

      <p class="intro">I build AI that works with real machines: self-hosted language models, retrieval over technical documentation and live device data over MCP, plus the infrastructure underneath. Main developer of SIGI, Gold at the Agrarfuchs innovation award 2026.</p>

      <section>
        <h2>Experience</h2>
        <div class="job">
          <div class="head"><h3>Software Developer, Schauer Agrotronic</h3><span>06/2022 – now</span></div>
          <p class="sub">Full-time since 07/2024, part-time alongside school before that. Software for barn equipment: low-power hardware, serial devices, touch screens in a stable.</p>
          <ul>
            <li>Main developer of <b>SIGI</b>, an AI service assistant that analyses faults using live machine data. Self-hosted open-weights model, RAG over the machine manuals including their images, an MCP server for the SDU-X controllers and an MCP aggregator that gives the agent one endpoint for every device. Gold at the Agrarfuchs innovation award 2026, work efficiency and workplace quality.</li>
            <li>Mentored an intern on the SIGI project.</li>
            <li>Led the migration of the company's touch interfaces from legacy Angular to the current stack.</li>
          </ul>
        </div>
      </section>

      <section>
        <h2>Projects</h2>
        {work.map((p) => (
          <div class="job">
            <div class="head"><h3>{p.name}</h3><span>{p.state}</span></div>
            <p>{p.summary}</p>
          </div>
        ))}
      </section>

      <section class="two">
        <div>
          <h2>Education</h2>
          <div class="head"><h3>HTBLA Grieskirchen, Informatik</h3><span>2019 – 2024</span></div>
          <p>Technical diploma, EQF level 5.</p>
          <h2 class="gap">Awards</h2>
          <p>Gold, Innovationspreis Agrarfuchs 2026, for SIGI<br />2nd place, Accenture Hackathon Vienna 2022</p>
        </div>
        <div>
          <h2>Skills</h2>
          <dl>{skills.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
        </div>
      </section>
    </article>
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  html { background: #e9e7e1; }
  body { margin: 0; font: 400 10pt/1.5 Inter, system-ui, sans-serif; color: #2a2926; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  article { width: 210mm; min-height: 297mm; margin: 24px auto; padding: 16mm 17mm; background: #fdfcf9; box-shadow: 0 10px 40px rgba(0,0,0,.12); }
  @media print { html { background: none; } article { margin: 0; box-shadow: none; } }
  a { color: inherit; text-decoration: none; }
  header { display: flex; justify-content: space-between; align-items: end; gap: 24px; padding-bottom: 14px; border-bottom: 1px solid #d9d6ce; }
  h1 { font: 400 28pt/1.05 Newsreader, Georgia, serif; letter-spacing: -0.01em; margin: 0; }
  .role { margin: 6px 0 0; color: #b4503f; font-size: 10.5pt; }
  .contact { margin: 0; text-align: right; font-size: 8.5pt; color: #6b6963; line-height: 1.6; }
  .intro { font: 400 12pt/1.5 Newsreader, Georgia, serif; margin: 14px 0 4px; color: #3a3935; }
  h2 { font: 500 8pt/1 Inter, sans-serif; text-transform: uppercase; letter-spacing: .12em; color: #8a877f; margin: 18px 0 8px; }
  h2.gap { margin-top: 16px; }
  h3 { font: 500 12.5pt/1.3 Newsreader, Georgia, serif; margin: 0; color: #1d1c1a; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .head span { font-size: 8.5pt; color: #8a877f; white-space: nowrap; }
  .job { margin-bottom: 9px; break-inside: avoid; }
  p { margin: 2px 0 0; }
  .sub { color: #6b6963; }
  ul { margin: 5px 0 0; padding-left: 14px; }
  li { margin-bottom: 3px; }
  li::marker { color: #b4503f; }
  b { font-weight: 600; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; }
  dt { color: #8a877f; }
  dd { margin: 0; }
</style>
