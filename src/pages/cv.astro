---
// One-page CV, built from the same data as the rest of the site.
// scripts/cv-pdf.mjs prints this page to /cv.pdf after every build.
// Plain reverse-chronological layout, one column, real text, so ATS parsers read it too.
// Written for applications in Finland: English, no date of birth or photo, location and relocation stated up front.
import { skills, yearsWorking, yearsFullTime } from '../lib/profile';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Kacper Noniewicz, CV</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <article>
      <header>
        <div>
          <h1>Kacper Noniewicz</h1>
          <p class="role">Software Developer</p>
        </div>
        <p class="contact">
          <a href="mailto:kacper@noniewicz.eu">kacper@noniewicz.eu</a><br />
          <a href="https://noniewicz.eu">noniewicz.eu</a> · <a href="https://github.com/knoniewicz">github.com/knoniewicz</a><br />
          <a href="https://www.linkedin.com/in/noniewicz">linkedin.com/in/noniewicz</a><br />
          Austria · open to relocating to Finland
        </p>
      </header>

      <p class="intro">Software developer with {yearsWorking}+ years of professional experience ({yearsFullTime}+ full-time), building touch interfaces, backend services and tooling for agricultural machines. Main stack: TypeScript and Angular at work, Go and Python on my own projects.</p>

      <section>
        <h2>Experience</h2>
        <div class="job">
          <div class="head"><h3>Software Developer, Schauer Agrotronic</h3><span>07/2024 – now</span></div>
          <p class="sub">Full-time. Software for barn equipment: low-power embedded hardware, serial devices, touch-first operation.</p>
          <ul>
            <li>Led the migration of the company's touch interfaces from legacy Angular to the current stack.</li>
            <li>Built most of SIGI, a self-hosted service assistant for technicians: search over the machine manuals and an MCP server that reads live state from the SDU-X controllers. Gold at the Agrarfuchs innovation award 2026.</li>
            <li>Mentored an intern.</li>
          </ul>
          <p class="stack">Angular, TypeScript, LLMs, RAG, MCP</p>
        </div>
        <div class="job">
          <div class="head"><h3>Software Developer (part-time), Schauer Agrotronic</h3><span>06/2022 – 06/2024</span></div>
          <ul><li>Built Angular touch interfaces for barn equipment alongside school.</li></ul>
          <p class="stack">Angular, TypeScript</p>
        </div>
      </section>

      <section>
        <h2>Education</h2>
        <div class="job">
          <div class="head"><h3>HTBLA Grieskirchen, Computer Science</h3><span>2019 – 2024</span></div>
          <p>Five-year higher technical college (HTL), diploma at EQF level 5. Diploma project Futura: my part was the ML pipeline, from technical indicators and feature selection to a LightGBM classifier for next-day stock direction.</p>
        </div>
      </section>

      <section>
        <h2>Personal projects</h2>
        <div class="job">
          <div class="head"><h3>Bober</h3><span>in daily use</span></div>
          <p>Coding agent I use every day. One Go process speaking the Agent Client Protocol with two built-in tools; everything else is a Lua extension. Also runs my home server.</p>
        </div>
        <div class="job">
          <div class="head"><h3>Pularis</h3><span>open source</span></div>
          <p>Go service that polls HTTP APIs and publishes changes as Redis events. Each source is one TOML file.</p>
        </div>
        <div class="job">
          <div class="head"><h3>Kor, Korpus, Kron</h3><span>retired 11/2026</span></div>
          <p>Event-driven backend for my home infrastructure: a TCP message router, a SQLite store that validates against JSON Schema and acknowledges only after commit, and a sandboxed Lua automation host.</p>
        </div>
      </section>

      <section>
        <h2>Awards</h2>
        <p>Gold, Agrarfuchs 2026, an Austrian agricultural innovation award, for SIGI<br />2nd place, Accenture Hackathon Vienna 2022</p>
      </section>

      <section>
        <h2>Skills and languages</h2>
        <dl>
          {skills.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
          <dt>spoken</dt><dd>Polish (native), German (fluent, C2), English (C1)</dd>
        </dl>
      </section>
    </article>
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  html { background: #e9e7e1; }
  body { margin: 0; font: 400 10pt/1.5 Inter, system-ui, sans-serif; color: #2a2926; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  article { width: 210mm; min-height: 297mm; margin: 24px auto; padding: 13mm 17mm; background: #fdfcf9; box-shadow: 0 10px 40px rgba(0,0,0,.12); }
  @media print { html { background: none; } article { margin: 0; box-shadow: none; } }
  a { color: inherit; text-decoration: none; }
  header { display: flex; justify-content: space-between; align-items: end; gap: 24px; padding-bottom: 14px; border-bottom: 1px solid #d9d6ce; }
  h1 { font: 400 28pt/1.05 Newsreader, Georgia, serif; letter-spacing: -0.01em; margin: 0; }
  .role { margin: 6px 0 0; color: #b4503f; font-size: 10.5pt; }
  .contact { margin: 0; text-align: right; font-size: 8.5pt; color: #6b6963; line-height: 1.6; }
  .intro { font: 400 12pt/1.5 Newsreader, Georgia, serif; margin: 14px 0 4px; color: #3a3935; }
  h2 { font: 500 8pt/1 Inter, sans-serif; text-transform: uppercase; letter-spacing: .12em; color: #8a877f; margin: 15px 0 7px; break-after: avoid; }
  h2.gap { margin-top: 16px; }
  h3 { font: 500 12.5pt/1.3 Newsreader, Georgia, serif; margin: 0; color: #1d1c1a; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .head span { font-size: 8.5pt; color: #8a877f; white-space: nowrap; }
  .job { margin-bottom: 9px; break-inside: avoid; }
  p { margin: 2px 0 0; }
  .sub { color: #6b6963; }
  ul { margin: 5px 0 0; padding-left: 14px; }
  li { margin-bottom: 3px; }
  li::marker { color: #b4503f; }
  b { font-weight: 600; }
  .stack { margin-top: 4px; font-size: 8.5pt; color: #8a877f; }
  dl { margin: 0; display: grid; grid-template-columns: auto 1fr auto 1fr; gap: 3px 12px; }

  dt { color: #8a877f; }
  dd { margin: 0; }
</style>
