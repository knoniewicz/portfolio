---
import Base from '../../layouts/Base.astro';
import ProjectPageHeader from '../ProjectPageHeader.astro';
import ProjectSection from '../ProjectSection.astro';
import ProjectList from '../ProjectList.astro';
import ProjectProse from '../ProjectProse.astro';
import TagList from '../TagList.astro';
---

<Base title="period / Kacper Noniewicz" description="A tiny self-hosted cycle tracker: one Go binary, one JSON file, no accounts and no external calls.">
  <div class="py-16 pb-20">
    <ProjectPageHeader label="Go / Self-hosted / Release planned" title="period" intro="A tiny self-hosted cycle tracker. One Go binary using only the standard library, one JSON file, no accounts and no external calls. Health data this personal should not live on someone else's server." />

    <div class="max-w-180">
      <ProjectSection title="What it does">
        <ProjectList items={[
          "Tap the first day of a period and the rest of the cycle is predicted from your own settings",
          "Cycle and period length, luteal phase and an optional fertile window",
          "Phone and laptop share the same state over the local network",
          "JSON export and import, so the data is never locked in",
        ]} />
      </ProjectSection>

      <ProjectSection title="How it works">
        <ProjectProse>
          <p>The server is a few hundred lines of Go with no dependencies outside the standard library. State lives in a single JSON file, written atomically with owner-only permissions, behind a small HTTP API that the web front end uses directly.</p>
        </ProjectProse>
      </ProjectSection>

      <ProjectSection title="Stack">
        <TagList tags={["Go", "stdlib only", "JSON", "Vanilla JS"]} />
      </ProjectSection>

      <ProjectSection title="Status">
        <ProjectProse>
          <p>In daily use on my home server. Planned for release.</p>
        </ProjectProse>
      </ProjectSection>
    </div>
  </div>
</Base>
