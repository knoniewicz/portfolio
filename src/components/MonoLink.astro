---
interface Props {
  href: string;
  target?: string;
  rel?: string;
  class?: string;
}
const { href, target, rel, class: cls = "" } = Astro.props;
---
<a href={href} target={target} rel={rel} class:list={["text-sm text-text-muted underline decoration-border-subtle underline-offset-4 hover:text-(--color-text) hover:decoration-current transition-colors", cls]}>
  <slot />
</a>
