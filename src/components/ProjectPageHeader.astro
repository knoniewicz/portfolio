---
interface Props {
  label: string;
  title: string;
  intro: string;
  repo?: string | null;
}
const { label, title, intro, repo } = Astro.props;
---
<a href="/#projects" class="inline-block mb-10 text-sm text-text-muted underline decoration-border-subtle underline-offset-4 hover:text-(--color-text) hover:decoration-current transition-colors">&larr; Projects</a>

<div class="mb-12 pb-8 border-b border-border-subtle">
  <p class="text-[0.8125rem] text-text-muted mb-3">{label}</p>
  <h1 class="font-serif text-[clamp(2.25rem,5vw,3.25rem)] font-normal tracking-[-0.015em] leading-[1.08] mb-5">{title}</h1>
  <p class="text-lg text-text-secondary max-w-150 leading-relaxed">{intro}</p>
  {repo && (
    <a href={repo} target="_blank" rel="noopener noreferrer" class="inline-block mt-5 text-sm text-(--color-text) underline decoration-(--color-accent) underline-offset-4">View on GitHub &rarr;</a>
  )}
</div>
