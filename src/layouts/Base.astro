---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  home?: boolean; // the home page brings its own layout, no header bar or footer
}

const { title = "Software Developer | Industrial Software, AI Infrastructure, Event-Driven Systems", description = "Software Developer. Go, TypeScript, Python.", home = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL('/kacper.jpg', Astro.site ?? Astro.url);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl.toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={socialImageUrl.toString()} />
    <meta property="og:site_name" content="Kacper Noniewicz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Profile for AI assistants" />
    <slot name="head" />
  </head>
  <body class="leading-relaxed">
    {home ? <slot /> : <>
    <div class="max-w-275 mx-auto px-8 max-md:px-5 rise">
      <slot />
    </div>
    <footer class="border-t border-border-subtle py-6">
      <div class="max-w-275 mx-auto px-8 max-md:px-5 text-[0.8125rem] text-text-muted">
        <span>&copy; {new Date().getFullYear()} Kacper Noniewicz</span>
      </div>
    </footer>
    </>}
    <script>
      // Underlines fill from the side the cursor comes in and drain out the side it leaves.
      document.addEventListener("pointerover", (e) => {
        const el = (e.target as Element).closest?.(".ul, .post a") as HTMLElement | null;
        if (!el || el.contains(e.relatedTarget as Node)) return;
        const r = el.getBoundingClientRect();
        el.style.backgroundPosition = (e.clientX < r.left + r.width / 2 ? "0" : "100%") + " 100%, 0 100%";
      });
      document.addEventListener("pointerout", (e) => {
        const el = (e.target as Element).closest?.(".ul, .post a") as HTMLElement | null;
        if (!el || el.contains(e.relatedTarget as Node)) return;
        const r = el.getBoundingClientRect();
        el.style.backgroundPosition = (e.clientX < r.left + r.width / 2 ? "0" : "100%") + " 100%, 0 100%";
      });
    </script>
  </body>
</html>
